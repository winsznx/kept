# Frontend (safe to expose; written by `npx convex dev`)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Local CLI binding (written by `npx convex dev`, never commit the real file)
CONVEX_DEPLOYMENT=

# Server-side secrets. Set these ONLY on the Convex deployment:
#   npx convex env set NAME value
# Never put them in a VITE_ variable.
# OPENAI_API_KEY
# OPENAI_MODEL_EXTRACT
# OPENAI_MODEL_REASON
# FIRECRAWL_API_KEY
# AGENTMAIL_API_KEY
# AGENTMAIL_WEBHOOK_SECRET
